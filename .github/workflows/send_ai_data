name: Send CSV every Friday

on:
  schedule:
    - cron: '0 7 * * 5'   # Every Friday at 07:00 UTC
  workflow_dispatch:       # Also allows manual trigger

env:
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true

jobs:
  send-email:
    runs-on: ubuntu-latest
    steps:
      - name: Download CSV
        run: |
          curl -L "https://github.com/microsoft/ai-diffusion-report/raw/refs/heads/main/data/AI_Diffusion_Q12026_Update.csv" \
               -o ai_diff.csv

      - name: Send email with CSVs
        uses: dawidd6/action-send-mail@v4
        with:
          server_address: smtp.gmail.com
          server_port: 465
          username: davidswelt@gmail.com
          password: ${{ secrets.EMAIL_PASSWORD }}
          subject: "Weekly CSV files"
          body: "Please find the three weekly CSV files attached."
          to: david.kohl@juliusbaer.com
          from: davidswelt@gmail.com
          attachments: ai_diff.csv
